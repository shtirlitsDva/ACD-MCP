<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Rvt.Mcp</RootNamespace>
    <AssemblyName>Rvt.Mcp</AssemblyName>
    <UseWPF>false</UseWPF>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- RoslynReferences (linked) reads in-memory PE blobs via pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Class libraries do NOT copy NuGet assets to output by default —
         without this the Roslyn DLLs never reach the deploy folder and the
         first script call dies with FileNotFoundException inside Revit. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release;ALCDebug;ALCRelease</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ALCDebug|x64'">
    <OutputPath>bin\Debug\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ALCRelease|x64'">
    <OutputPath>bin\Release\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only Revit 2025 API (CI-friendly, mirrors the AutoCAD.NET
         NuGet pattern). Revit provides the real assemblies at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- RvtGlobals (the REPL globalsType) lives here so it ends up in the
         host's default (non-collectible) ALC, not this collectible plugin's
         ALC — otherwise the Roslyn script submission can't reference it. Under
         DevReload that means "Rvt.Mcp.Api" must be in SharedAssemblies.Config.json
         below; RevitPluginManager pre-loads the side-by-side DLL into the
         default ALC before this plugin loads. Twin of Acd.Mcp -> Acd.Mcp.Api. -->
    <ProjectReference Include="..\Rvt.Mcp.Api\Rvt.Mcp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DevReload reads this side-by-side config next to Rvt.Mcp.dll to decide
         which assemblies to pre-load into the default ALC. Copied to output on
         every build so a fresh clone never produces a broken bin/. -->
    <None Include="SharedAssemblies.Config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- AutoCAD-free pieces shared with the AutoCAD plugin via linked
         compile — wire types and Roslyn plumbing are host-agnostic. -->
    <Compile Include="..\..\Autocad\Acd.Mcp\Pipe\Protocol.cs" Link="Shared\Protocol.cs" />
    <Compile Include="..\..\Autocad\Acd.Mcp\ExecuteResult.cs" Link="Shared\ExecuteResult.cs" />
    <Compile Include="..\..\Autocad\Acd.Mcp\Scripting\TrailingExpressionRewriter.cs" Link="Shared\TrailingExpressionRewriter.cs" />
    <Compile Include="..\..\Autocad\Acd.Mcp\Scripting\RoslynReferences.cs" Link="Shared\RoslynReferences.cs" />
    <Compile Include="..\..\Autocad\Acd.Mcp\Scripting\ConsoleCapture.cs" Link="Shared\ConsoleCapture.cs" />
  </ItemGroup>

</Project>
