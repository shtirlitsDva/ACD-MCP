<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121.

     The "IsolatedALC" build flavour — publishes to the NSLOAD catalogue folder.
     IsolatedAlc=true makes Acd.Mcp.csproj define the ISOLATED_ALC compiler symbol,
     so McpPlugin emits the empty [CommandClass(NoAutoCommands)] marker that
     suppresses AutoCAD's ExtensionLoader auto-scan. Required because NSLOAD
     byte-loads the DLL into a collectible ALC and registers the commands itself;
     without the marker the second reload throws eDuplicateKey. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>X:\AutoCAD DRI - 01 Civil 3D\NetloadV2\2025\ACD-MCP</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IsolatedAlc>true</IsolatedAlc>
  </PropertyGroup>
</Project>